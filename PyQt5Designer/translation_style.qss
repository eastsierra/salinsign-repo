/* Main styles for Translation Module */
QWidget {
    font-family: Arial, sans-serif;
}

QMainWindow {
    background-color: white;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: #f0f8ff;
}

/* Box styles */
#box1, #box2 {
    background-color: #f5f5f5;
    border-radius: 10px;
    border: 1px solid #ddd;
    min-height: 400px;
}

#box1 {
    background-color: #f0f8ff;
}

#box2 {
    background-color: #f0f8ff;
}

/* Input field styles */
QLineEdit {
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #ccc;
    font-size: 14px;
    background-color: white;
}

QLineEdit:focus {
    border: 2px solid #4CAF50;
}

/* Button styles */
QPushButton {
    padding: 10px 20px;
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 14px;
    font-weight: bold;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #45a049;
}

QPushButton:pressed {
    background-color: #3d8b40;
}

/* Video placeholder */
#videoPlaceholder {
    background-color: #000;
    color: #fff;
    min-height: 300px;
    border-radius: 5px;
}

/* Chat box styles */
#chatBox {
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 5px;
    padding: 10px;
    font-size: 14px;
    min-height: 300px;
}

/* Back button */
#backButton {
    background-color: transparent;
    border: none;
}

#backButton:hover {
    opacity: 0.8;
}

/* Header image */
#headerImage {
    margin-bottom: 20px;
}

/* Message styling for the chat */
.message {
    margin: 5px 0;
    padding: 12px 15px;
    border-radius: 18px;
    max-width: 80%;
    word-wrap: break-word;
    display: inline-block;
    position: relative;
    font-size: 14px;
    line-height: 1.4;
}

/* Patient messages (left-aligned) */
.user1 {
    background-color: #e3f2fd;
    border-bottom-left-radius: 5px;
    text-align: left;
    margin-right: auto;
    float: left;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1); 
    color: #333;
}

/* Doctor messages (right-aligned) */
.user2 {
    background-color:rgb(151, 205, 255);
    border-bottom-right-radius: 5px;
    text-align: left;
    margin-left: auto;
    float: right;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    color: #333;
}

/* Mobile-specific styles */
@media screen and (max-width: 768px) {
    #box1, #box2 {
        min-height: 300px;
        margin-bottom: 15px;
    }
    
    QLineEdit {
        padding: 8px;
        font-size: 12px;
    }
    
    QPushButton {
        padding: 8px 15px;
        font-size: 12px;
        min-width: 60px;
    }
    
    #videoPlaceholder {
        min-height: 200px;
    }
    
    #chatBox {
        min-height: 200px;
        font-size: 12px;
    }
    
    #headerImage {
        margin-bottom: 15px;
    }
} 